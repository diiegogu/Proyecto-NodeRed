    {
        "id": "808761df17d0d2a3",
        "type": "template",
        "z": "31608239e125702b",
        "name": "Hola Mundo",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lectura de sensores</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background: #f1f5f9;\n            text-align: center;\n            padding: 40px;\n        }\n\n        h1 {\n            color: #1e293b;\n        }\n\n        .sensor {\n            background: white;\n            padding: 25px;\n            margin: 20px auto;\n            max-width: 350px;\n            border-radius: 12px;\n            box-shadow: 0 4px 10px #0002;\n        }\n\n        .valor {\n            font-size: 32px;\n            color: #15803d;\n            font-weight: bold;\n        }\n    </style>\n</head>\n<body>\n    <h1>Monitor de sensores</h1>\n\n    <div class=\"sensor\">\n        <h2>Temperatura</h2>\n        <p class=\"valor\">{{req.params.temp}} °C</p>\n    </div>\n\n    <div class=\"sensor\">\n        <h2>Humedad</h2>\n        <p class=\"valor\">{{req.params.hum}} %</p>\n    </div>\n</body>\n</html>",
        "output": "str",
        "x": 730,
        "y": 100,
        "wires": [
            [
                "911aa877f32d7446"
            ]
        ]
    },
    {
        "id": "ef383c0e778c9e41",
        "type": "function",
        "z": "31608239e125702b",
        "name": "function 1",
        "func": "const temp = Number(msg.req.params.temp);\nconst hum = Number(msg.req.params.hum);\n\nmsg.payload = {\n    temperatura: temp,\n    humedad: hum,\n    unidadTemperatura: \"°C\",\n    unidadHumedad: \"%\"\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
